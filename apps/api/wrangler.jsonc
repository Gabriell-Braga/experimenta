// Deploy da API na Cloudflare (Worker + D1 + KV). Ver docs/DEPLOY.md.
{
  "name": "abtest-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Roda o Worker perto do D1 (cada consulta ao banco deixa de cruzar o continente).
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abtest-db",
      "database_id": "e608bdf8-29a4-4069-b272-398177d4887a",
      "migrations_dir": "migrations-d1"
    }
  ],
  "kv_namespaces": [{ "binding": "CDN", "id": "c8a2bc427ff5448098a79ce2fb645e15" }],
  "vars": {
    "PUBLIC_URL": "https://abtest-api.hub-villa-deli.workers.dev",
    "EDITOR_ORIGINS": "https://abtest-editor.hub-villa-deli.workers.dev,http://localhost:5173",
    "DEMO_SITE_URL": "https://abtest-demo.hub-villa-deli.workers.dev/",
    "HEATMAP_SAMPLE_RATE": "1",
    "EVENTS_RETENTION_DAYS": "90",
    // Ideias de teste com Gemini (camada grátis); chave no secret AI_API_KEY.
    "AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "AI_MODEL": "gemini-3.5-flash,gemini-3.1-flash-lite",
    "AI_REASONING": "none"
  },
  // Expurgo diário dos eventos crus (retenção).
  // Um cron só: o plano grátis tem 5 por conta inteira. O expurgo diário roda na execução das 4h (UTC).
  "triggers": { "crons": ["0 * * * *"] }
}
