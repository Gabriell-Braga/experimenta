{
  "manifest_version": 3,
  "name": "A/B Editor — modo edição",
  "version": "0.1.0",
  "description": "Permite abrir no editor visual sites que bloqueiam iframe ou ainda não têm o snippet. Só age em sessões iniciadas pelo app do editor.",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
