{
  "name": "abtest",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @abtest/e2e e2e",
    "deploy:cf": "tsx scripts/deploy-cloudflare.ts",
    "seed:data": "tsx scripts/seed-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/node": "22",
    "eslint": "9",
    "fflate": "0.8",
    "globals": "16",
    "prettier": "3",
    "tsx": "4",
    "turbo": "2",
    "typescript": "6",
    "typescript-eslint": "8",
    "vitest": "3"
  },
  "pnpm": {
    "overrides": {
      "react-native": "-",
      "@react-native-async-storage/async-storage": "-"
    }
  }
}
